# Files Docker should NOT copy into the image.
#
# Every excluded file makes the build faster and the image smaller. Anything
# listed here is simply invisible to the Dockerfile.

# --- the 120 MB of raw Kaggle CSVs and the 20 MB intermediate table --------
data/

# --- local Python environment (Windows binaries - useless in a Linux image) -
venv/
.venv/
__pycache__/
*.py[cod]

# --- node_modules is reinstalled inside the build from package-lock.json ----
frontend/node_modules/
frontend/br_states_raw.json

# --- build output: stage 1 regenerates this, so never copy a stale copy -----
static/

# --- training and analysis scripts: not needed to SERVE the app ------------
src/
reports/
screenshots/
streamlit_app.py
requirements-dev.txt

# --- git and editor clutter ------------------------------------------------
.git/
.github/
.gitignore
.vscode/
.idea/
.claude/
*.md
!README.md
